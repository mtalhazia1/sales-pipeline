[Unit]
Description=Sales Pipeline daily SQLite snapshot

[Service]
Type=oneshot
User=sales-pipeline
Group=sales-pipeline
WorkingDirectory=/srv/sales-pipeline/server
Environment=SP_DATA_DIR=/var/lib/sales-pipeline
ExecStart=/srv/sales-pipeline/.venv/bin/python -m app.backup
# Must match the main unit: systemd re-applies the mode on every start (the default 0755 opened the data to other users).
StateDirectory=sales-pipeline
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
